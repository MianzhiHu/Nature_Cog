wsls_data$exploration <- factor(wsls_data$exploration, levels = c(0, 1), labels = c('exploitation', 'exploration'))
wsls_data$EV_rank <- factor(wsls_data$EV_rank, levels = c('1st', '2nd', '3rd', '4th'))
