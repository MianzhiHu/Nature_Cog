dm_summary_overall <- read.csv("C:/Users/zuire/PycharmProjects/Nature_Cog/data/dm_summary_overall.csv")
dm_summary_overall$Condition <- factor(dm_summary_overall$Condition, levels = c('Nature', 'Urban', 'Control'))
dm_summary_overall$keyResponse <- factor(dm_summary_overall$keyResponse, levels = c(1, 2, 3, 4), labels = c('A', 'B', 'C', 'D'))
model <- lmer(proportion ~ Condition * keyResponse + (1 |Subnum),
data = dm_summary_overall)
summary(model)
plot(allEffects(model))
model <- lmer(proportion ~ Condition * keyResponse + BestOption + HighFreqOption + (1 |Subnum),
data = dm_summary_overall)
summary(model)
plot(allEffects(model))
dm_summary_overall <- read.csv("C:/Users/zuire/PycharmProjects/Nature_Cog/data/dm_summary_overall.csv")
dm_summary_overall <- read.csv("C:/Users/zuire/PycharmProjects/Nature_Cog/data/dm_summary_overall.csv")
dm_summary_overall$Condition <- factor(dm_summary_overall$Condition, levels = c('Nature', 'Urban', 'Control'))
model <- lmer(BestOption_IGT ~ Condition + BestOption_SGT + (1 |Subnum),
data = dm_summary_overall)
model <- glm(BestOption_IGT ~ Condition + BestOption_SGT,
data = dm_summary_overall)
summary(model)
plot(allEffects(model))
model <- glm(HighFreqOption_IGT ~ Condition + HighFreqOption_SGT,
data = dm_summary_overall)
summary(model)
plot(allEffects(model))
