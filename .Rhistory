E1_dm_summary_modeled$Condition <- factor(dm_summary_modeled$Condition, levels = c('Control', 'Nature', 'Urban'))
E1_dm_summary_modeled$Condition <- factor(E1_dm_summary_modeled$Condition, levels = c('Control', 'Nature', 'Urban'))
E1_dm_summary_modeled$Task <- factor(E1_dm_summary_modeled$Task, levels = c(1, 2), labels = c("First", "Second"))
