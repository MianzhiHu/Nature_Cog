summary(switch_model)
plot(allEffects(switch_model))
switch_model <- glm(LoseShift ~ Condition * Task, data = wsls_data)
summary(switch_model)
plot(allEffects(switch_model))
switch_model <- glm(WSLS ~ Condition * Task, data = wsls_data)
summary(switch_model)
plot(allEffects(switch_model))
switch_model <- glm(Switch~ Condition * Task, data = wsls_data)
summary(switch_model)
plot(allEffects(switch_model))
switch_model <- glm(Switch~ Condition * Task, data = wsls_data, family = 'binomial')
summary(switch_model)
plot(allEffects(switch_model))
